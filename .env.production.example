# Vunachain Production Environment Configuration Example
# Copy to .env.production and fill in actual production values
# NEVER commit real secrets to version control

# ═══════════════════════════════════════════════════════════════════════
# BACKEND (apps/backend) - Production Settings
# ═══════════════════════════════════════════════════════════════════════

# Django Security
SECRET_KEY=<generate-random-secret-key-256-chars-min>
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,www.yourdomain.com

# Database - Use managed PostgreSQL
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Blockchain (Celo Mainnet)
CELO_PRIVATE_KEY=<your-mainnet-private-key>
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220

# M-Pesa Daraja - Production Credentials
MPESA_ENV=production
MPESA_CONSUMER_KEY=<get-from-safaricom-production>
MPESA_CONSUMER_SECRET=<get-from-safaricom-production>
MPESA_SHORTCODE=<your-production-shortcode>

# CMS - Sanity Project
SANITY_PROJECT_ID=<your-sanity-project-id>
SANITY_DATASET=production

# farmOS (EUDR Compliance)
FARMOS_URL=https://your-farmos-production-instance.com
FARMOS_API_KEY=<your-farmos-api-key>

# Error Tracking
SENTRY_DSN=<your-sentry-production-dsn>

# ═══════════════════════════════════════════════════════════════════════
# FRONTEND (apps/landing) - Production Settings
# ═══════════════════════════════════════════════════════════════════════

VITE_API_URL=https://api.yourdomain.com
VITE_SENTRY_DSN=<your-sentry-frontend-dsn>
VITE_SANITY_PROJECT_ID=<your-sanity-project-id>
VITE_SANITY_DATASET=production

# ═══════════════════════════════════════════════════════════════════════
# PROTOCOL (apps/protocol) - Production Deployment
# ═══════════════════════════════════════════════════════════════════════

PRIVATE_KEY=<your-mainnet-deployment-account-private-key>
CUSD_ADDRESS_MAINNET=0x765de816845861e75a25fca122bb6898b50b17fa
