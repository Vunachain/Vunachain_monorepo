# Docker Environment Configuration
# Copy this file to .env.docker and update with your values

# Database Configuration
DB_NAME=vunachain
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=db
DB_PORT=5432

# Django Configuration
SECRET_KEY=your-very-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*.example.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000
NODE_ENV=production

# Third-party API Keys (Testnet)
GEMINI_API_KEY=your_gemini_api_key_here
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production

# Blockchain Configuration (Celo Alfajores Testnet)
CELO_NETWORK=alfajores
CELO_RPC_URL=https://alfajores-forno.celo-testnet.org
CELO_PRIVATE_KEY=your_test_wallet_private_key

# M-Pesa Configuration (Sandbox)
MPESA_SHORTCODE=174379
MPESA_API_KEY=your_mpesa_sandbox_key
MPESA_PASSKEY=your_mpesa_sandbox_passkey

# Sentry Configuration (Optional)
SENTRY_DSN=

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password

# Container Memory Limits (Optional)
# Uncomment to set memory limits
# BACKEND_MEMORY=512m
# FRONTEND_MEMORY=256m
# DB_MEMORY=1024m
