# Django Backend Environment Variables
# Copy this file to .env and update the values as needed

# ═══════════════════════════════════════════════════════════════════════
# DJANGO SETTINGS
# ═══════════════════════════════════════════════════════════════════════
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ═══════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
# SQLite for local development
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL for production (Railway)
# DATABASE_URL=postgres://user:password@host:port/database

# ═══════════════════════════════════════════════════════════════════════
# BLOCKCHAIN (CELO SEPOLIA L2)
# ═══════════════════════════════════════════════════════════════════════
# Private key for the relayer/admin account (needed for batch payouts and relayer)
CELO_PRIVATE_KEY=0x...

# RPC Provider (Celo Sepolia L2)
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_CHAIN_ID=11142220

# Smart Contract Addresses (Lean-Chain V2)
TRACEABILITY_V2_ADDRESS_SEPOLIA=0x...
TRACEABILITY_V2_ADDRESS_MAINNET=0x...

# ═══════════════════════════════════════════════════════════════════════
# M-PESA DARAJA API
# ═══════════════════════════════════════════════════════════════════════
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_KEY
MPESA_CONSUMER_SECRET=YOUR_SECRET
MPESA_SHORTCODE=174379
MPESA_INITIATOR_NAME=Vunachain
MPESA_SECURITY_CREDENTIAL=YOUR_CREDENTIAL
MPESA_CALLBACK_URL=https://your-domain.com/api/payouts/mpesa-callback/

# ═══════════════════════════════════════════════════════════════════════
# SANITY CMS (Content for LLM ingestion)
# ═══════════════════════════════════════════════════════════════════════
SANITY_PROJECT_ID=gevf0weh
SANITY_DATASET=development

# ═══════════════════════════════════════════════════════════════════════
# farmOS INTEGRATION (EUDR Compliance)
# ═══════════════════════════════════════════════════════════════════════
FARMOS_URL=https://your-farmos-instance.com
FARMOS_API_KEY=your_api_key

# ═══════════════════════════════════════════════════════════════════════
# WEBHOOKS & NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════
VUNACHAIN_WEBHOOK_URL=https://your-app.com/webhooks/vunachain
