# Vunachain Environment Variables Configuration Guide
#
# This is a TEMPLATE file. DO NOT commit actual secrets here.
#
# For development: Copy to apps/backend/.env, apps/landing/.env, apps/protocol/.env
# For production: Use GitHub Secrets and deployed environment variables
#
# See docs/SECRETS_MANAGEMENT.md for detailed setup instructions
# See .env.development.example for local development setup
# See .env.production.example for production setup

# ═══════════════════════════════════════════════════════════════════════
# BACKEND (apps/backend)
# ═══════════════════════════════════════════════════════════════════════

# Django Security (Never use the default in production!)
SECRET_KEY=<your-random-secret-key-256-chars-minimum>

# Debugging (Always False in production)
DEBUG=True

# Allowed Hosts (Update for your domain)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Development: SQLite or local PostgreSQL
# Production: Managed PostgreSQL database
DATABASE_URL=sqlite:///db.sqlite3

# Blockchain Configuration (Celo)
CELO_PRIVATE_KEY=<your-private-key>
CELO_RPC_URL=https://forno.celo-alfajores.org
CELO_CHAIN_ID=44787

# M-Pesa Payment Integration
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=<get-from-safaricom>
MPESA_CONSUMER_SECRET=<get-from-safaricom>
MPESA_SHORTCODE=174379

# CMS Configuration (Sanity)
SANITY_PROJECT_ID=<ask-team-for-project-id>
SANITY_DATASET=development

# farmOS Integration (EUDR Compliance)
FARMOS_URL=https://your-farmos-instance.com
FARMOS_API_KEY=<your-api-key>

# ═══════════════════════════════════════════════════════════════════════
# FRONTEND (apps/landing)
# ═══════════════════════════════════════════════════════════════════════

# API Endpoint (Points to backend)
VITE_API_URL=http://localhost:8000/api

# Error Tracking (Sentry)
VITE_SENTRY_DSN=<your-sentry-dsn>

# CMS Configuration
VITE_SANITY_PROJECT_ID=<ask-team-for-project-id>
VITE_SANITY_DATASET=development

# ═══════════════════════════════════════════════════════════════════════
# PROTOCOL (apps/protocol)
# ═══════════════════════════════════════════════════════════════════════

# Deployment Account Private Key
PRIVATE_KEY=<your-testnet-private-key>

# Celo Testnet Token Address
CUSD_ADDRESS_ALFAJORES=0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1

# Celo Mainnet Token Address (for production deployment)
CUSD_ADDRESS_MAINNET=0x765de816845861e75a25fca122bb6898b50b17fa

# ═══════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════════════
#
# 1. Local Development:
#    cp .env.development.example apps/backend/.env
#    cp .env.development.example apps/landing/.env
#    cp .env.development.example apps/protocol/.env
#    Contact team lead for actual values
#
# 2. Production Deployment:
#    Use GitHub Secrets (Settings → Secrets and variables → Actions)
#    See .env.production.example and docs/SECRETS_MANAGEMENT.md
#
# 3. Security:
#    - Never commit actual .env files
#    - Use git-secrets to prevent accidental commits
#    - Rotate secrets every 90 days
#    - Use different secrets for each environment
