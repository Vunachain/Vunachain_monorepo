# Vunachain Master Environment Variables Example
# Copy this to .env (not recommended for monorepo root) or use with specific app/ subdirectories.

# ═══════════════════════════════════════════════════════════════════════
# BACKEND (apps/backend)
# ═══════════════════════════════════════════════════════════════════════
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Blockchain (Celo Sepolia)
CELO_PRIVATE_KEY=0x...
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_CHAIN_ID=11142220

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_KEY
MPESA_CONSUMER_SECRET=YOUR_SECRET
MPESA_SHORTCODE=174379

# CMS
SANITY_PROJECT_ID=gevf0weh
SANITY_DATASET=development

# farmOS (EUDR Compliance)
FARMOS_URL=https://your-farmos-instance.com
FARMOS_API_KEY=your_api_key

# ═══════════════════════════════════════════════════════════════════════
# FRONTEND (apps/landing)
# ═══════════════════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:8000/api
VITE_SENTRY_DSN=your-sentry-dsn
VITE_SANITY_PROJECT_ID=gevf0weh
VITE_SANITY_DATASET=production

# ═══════════════════════════════════════════════════════════════════════
# PROTOCOL (apps/protocol)
# ═══════════════════════════════════════════════════════════════════════
PRIVATE_KEY=0x...
CUSD_ADDRESS_ALFAJORES=0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1
