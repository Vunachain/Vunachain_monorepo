# Vunachain Development Environment Configuration Example
# Copy to .env (git-ignored) for local development
# Get actual values from team lead

# ═══════════════════════════════════════════════════════════════════════
# BACKEND (apps/backend) - Development Settings
# ═══════════════════════════════════════════════════════════════════════

# Django Development
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.local

# Database - SQLite for development or local PostgreSQL
DATABASE_URL=sqlite:///db.sqlite3
# Or use PostgreSQL: postgres://user:password@localhost:5432/vunachain_dev

# Blockchain (Celo Testnet - Alfajores)
CELO_PRIVATE_KEY=<your-testnet-private-key>
CELO_RPC_URL=https://forno.celo-alfajores.org
CELO_CHAIN_ID=44787

# M-Pesa Daraja - Sandbox
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=<get-from-safaricom-sandbox>
MPESA_CONSUMER_SECRET=<get-from-safaricom-sandbox>
MPESA_SHORTCODE=174379

# CMS - Sanity Project
SANITY_PROJECT_ID=<ask-team-for-dev-project-id>
SANITY_DATASET=development

# farmOS (EUDR Compliance)
FARMOS_URL=https://your-farmos-dev-instance.com
FARMOS_API_KEY=<your-dev-api-key>

# Error Tracking
SENTRY_DSN=<your-sentry-dev-dsn>

# ═══════════════════════════════════════════════════════════════════════
# FRONTEND (apps/landing) - Development Settings
# ═══════════════════════════════════════════════════════════════════════

VITE_API_URL=http://localhost:8000/api
VITE_SENTRY_DSN=<optional-for-dev>
VITE_SANITY_PROJECT_ID=<ask-team-for-dev-project-id>
VITE_SANITY_DATASET=development

# ═══════════════════════════════════════════════════════════════════════
# PROTOCOL (apps/protocol) - Development/Testing
# ═══════════════════════════════════════════════════════════════════════

PRIVATE_KEY=<your-testnet-account-private-key>
CUSD_ADDRESS_ALFAJORES=0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1
